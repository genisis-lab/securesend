{
  "name": "securesend-signal",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for SecureSend: WebRTC signaling, rate limiting, TURN config, and optional zero-knowledge R2 store-and-forward.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings",
    "typecheck": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --check && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
